{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UnityCatalogS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads",
        "s3:ListMultipartUploadParts",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::sk-databricks-uc-AWS_ACCOUNT_ID-us-west-2",
        "arn:aws:s3:::sk-databricks-uc-AWS_ACCOUNT_ID-us-west-2/*"
      ]
    },
    {
      "Sid": "UnityCatalogSelfAssume",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole"
      ],
      "Resource": [
        "arn:aws:iam::AWS_ACCOUNT_ID:role/databricks-unity-catalog-access"
      ]
    }
  ]
}
